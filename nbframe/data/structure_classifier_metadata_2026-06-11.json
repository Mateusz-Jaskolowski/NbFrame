{
  "model_file": "structure_classifier_pipeline_2026-06-11.joblib",
  "date_trained": "2026-06-11",
  "feature_cols": [
    "cos_alpha_N",
    "tau_N",
    "cos_alpha_C",
    "tau_C",
    "contact_density",
    "fr2_rsa_key"
  ],
  "label_mapping": {
    "kinked": 1,
    "extended": 0
  },
  "train_csv": "structures_for_labeling_dedup.csv",
  "feature_engineering": {
    "version": "0.2.0",
    "dihedral_encoding": {
      "type": "cosine",
      "applies_to": [
        "alpha_N",
        "alpha_C"
      ],
      "formula": "cos_alpha = cos(radians(alpha))",
      "note": "CDR3 dihedrals alpha_N/alpha_C are encoded as cos(angle) instead of raw degrees. Raw degrees are unstable near the +/-180 branch cut (a ~2 deg geometric change flips the sign and the linear model overreacts); cos() is wraparound-safe and captures the trans/gauche character. tau_N/tau_C are bounded bond angles and are kept linear."
    },
    "contact_density": {
      "type": "soft_logistic",
      "switch_midpoint": 4.5,
      "switch_width": 0.4,
      "formula": "contact_weight(d) = 1 / (1 + exp((d - midpoint) / width))",
      "normalization": "sum of pair contact weights / non-stem CDR3 length present"
    }
  },
  "confidence_thresholds": {
    "kinked_threshold": 0.55,
    "extended_threshold": 0.25
  },
